{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": ["../frontend/node_modules/@types"],
    "paths": {
      "react": ["../frontend/node_modules/@types/react"],
      "react/*": ["../frontend/node_modules/@types/react/*"],
      "three": ["../frontend/node_modules/@types/three"],
      "three/*": ["../frontend/node_modules/@types/three/*"]
    }
  },
  "include": ["contracts/**/*.ts", "frontend/**/*.ts", "frontend/**/*.tsx"]
}
