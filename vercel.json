{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/.next",
  "functions": {
    "frontend/app/backend/[...path]/route.ts": {
      "maxDuration": 10
    }
  }
}
